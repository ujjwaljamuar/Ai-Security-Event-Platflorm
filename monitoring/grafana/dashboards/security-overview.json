
{
  "uid": "security-overview",
  "title": "Security Event Detection Overview",
  "tags": ["security", "fraud-detection"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Events Processed / Second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(security_events_processed_total[1m]))",
          "legendFormat": "Events/sec",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Rejected Records / Second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(security_records_rejected_total[1m]))",
          "legendFormat": "Rejected/sec",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Alerts Created / Second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(security_alerts_created_total[1m]))",
          "legendFormat": "Alerts/sec",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Consumer Batch Processing P95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(security_consumer_batch_processing_seconds_bucket[5m])))",
          "legendFormat": "P95 seconds",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "API Request Rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(security_api_requests_total[1m]))",
          "legendFormat": "HTTP {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Consumer Errors",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(security_consumer_errors_total[1m]))",
          "legendFormat": "Errors/sec",
          "refId": "A"
        }
      ]
    }
  ]
}
